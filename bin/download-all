#!/usr/bin/env bash

set -euo pipefail

if [ "$(basename "$(pwd)")" != "mrva-open-source-download" ] ; then
    echo "Please run from mrva-open-source-download directory"
    exit 1
fi

if [ $# -ne 1 ]; then
    echo "Wrong number of arguments."
    echo "Usage: $0 repo-list-file"
    exit 1
fi

repos=$1
outpath=no-such-path

cleanup() {
    echo "Caught an interrupt signal. Cleaning up..."
    if [ "$outpath" != "no-such-path" ]; then
        echo "Removing $outpath"
        rm -fR "$outpath"
    fi
    echo "Cleanup completed."
    exit 0
}

trap cleanup SIGINT SIGTERM


get-db () {
    path=$1
    relpath=.$path

    if [ -f "$relpath/db.zip" ]; then
        printf "Already exists: %s\n" "$relpath/db.zip"
        return
    fi

    printf "Downloading %s/db.zip\n" "$relpath"
    mkdir -p "$relpath"

    outpath="$relpath/db.zip"
    gh api \
        -H "Accept: application/zip" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "$path" > "$outpath"
}


get-sarif () {
    db_path=$1
    # convert:
    #   /repos/org/repo/code-scanning/codeql/databases/cpp
    # → /repos/org/repo/code-scanning/analyses
    sarif_base=$(echo "$db_path" | sed 's#/code-scanning/codeql/databases.*#/code-scanning/analyses#')
    relpath=.$sarif_base

    mkdir -p "$relpath"

    # list analyses
    gh api "$sarif_base" --jq '.[].id' | while read -r id; do
        out="$relpath/$id.sarif"
        if [ -f "$out" ]; then
            printf "Already exists: %s\n" "$out"
            continue
        fi
        printf "Downloading %s -> %s\n" "$sarif_base/$id" "$out"
        gh api \
            -H "Accept: application/sarif+json" \
            "$sarif_base/$id" > "$out"
    done
}


cat "$repos" | while read -r path; do
    [ -z "$path" ] && continue
    get-db "$path"
    get-sarif "$path"
done
