#!/usr/bin/env -S uv run python
# -*- python -*-

import requests

headers = {"Authorization": "token YOUR_TOKEN"}
repos = []
for page in range(1, 11):  # 10 pages × 100 = 1000
    r = requests.get(
        "https://api.github.com/search/repositories",
        params={
            "q": "language:python",
            "sort": "stars",
            "order": "desc",
            "per_page": 100,
            "page": page
        },
        headers=headers
    )
    repos.extend(r.json()["items"])
